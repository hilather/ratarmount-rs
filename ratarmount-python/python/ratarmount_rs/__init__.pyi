from os import PathLike
from typing import BinaryIO, Iterable, Iterator, Literal, Optional, Union

class RatarmountError(Exception): ...
class MemberNotFound(KeyError, RatarmountError): ...
class BadPassword(RatarmountError): ...
class NotMappable(RatarmountError): ...

class Entry:
    @property
    def name(self) -> str: ...
    @property
    def path(self) -> str: ...
    @property
    def is_dir(self) -> bool: ...
    @property
    def is_file(self) -> bool: ...
    @property
    def is_symlink(self) -> bool: ...
    @property
    def size(self) -> int: ...
    @property
    def mtime(self) -> Optional[int]: ...
    @property
    def mode(self) -> int: ...

class Archive:
    @property
    def closed(self) -> bool: ...
    @property
    def index(self) -> ArchiveIndex: ...
    def mount(self, mountpoint: Union[str, PathLike[str]], **opts) -> Mount: ...
    def ls(self, path: str = "/") -> list[Entry]: ...
    def stat(self, path: str) -> Entry: ...
    def read(self, path: str, offset: int = 0, size: int = -1) -> bytes: ...
    def open(self, path: str) -> BinaryIO: ...
    def mmap(self, path: str) -> memoryview: ...
    def iter(self, prefix: str = "/", order: Literal["archive", "name"] = "archive") -> Iterator[Entry]: ...
    def extract(self, members: Iterable[str], dest: Union[str, PathLike[str]], *, existing: Literal["skip", "replace"] = "skip") -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Archive: ...
    def __exit__(self, *exc: object) -> None: ...

def open(path_or_url: Union[str, PathLike[str]], *, password: Optional[str] = None, index: Optional[Union[str, PathLike[str]]] = None, recursive: bool = False, parallelization: int = 1) -> Archive: ...
def split_url(url: str) -> str: ...

class Mount:
    path: str
    @property
    def alive(self) -> bool: ...
    def unmount(self) -> None: ...
    def wait(self, timeout: Optional[float] = None) -> int: ...
    def __enter__(self) -> Mount: ...
    def __exit__(self, *exc: object) -> None: ...

class PublishedIndex:
    @property
    def index_id(self) -> str: ...
    @property
    def pointer_url(self) -> str: ...
    @property
    def blob_url(self) -> str: ...
    @property
    def commit(self) -> Optional[str]: ...
    @property
    def pull_request_url(self) -> Optional[str]: ...
    @property
    def urls(self) -> tuple[str, str]: ...

class ArchiveIndex:
    def publish(self, destination: Optional[Union[str, PathLike[str]]] = None, *, revision: Optional[str] = None, create_pr: bool = False) -> PublishedIndex: ...

def publish_index(archive: Archive, destination: Optional[Union[str, PathLike[str]]] = None, *, revision: Optional[str] = None, create_pr: bool = False) -> PublishedIndex: ...
def mount(source: Union[str, PathLike[str], Iterable[Union[str, PathLike[str]]]], mountpoint: Union[str, PathLike[str]], *, write_overlay: Optional[Union[str, PathLike[str]]] = None, overlay_tmpfs: Union[bool, str] = False, recursive: bool = False, options: str = "", passthrough: Literal["auto", "on", "off"] = "auto", readonly_globs: Optional[Union[str, Iterable[str]]] = None, quota: Optional[Union[int, str]] = None, uid: Optional[int] = None, gid: Optional[int] = None, foreground: bool = False, **kwargs) -> Mount: ...
