# Optional source-build package; submit as ratarmount-rs on the AUR.
# Maintainer: ratarmount-rs maintainers
pkgname=ratarmount-rs
pkgver=0.1.34
pkgrel=1
pkgdesc='Mount archives as a filesystem with random access (build from source)'
arch=('x86_64' 'aarch64')
url='https://github.com/hilather/ratarmount-rs'
license=('MIT')
makedepends=('rust' 'pkgconf' 'openssl' 'sqlite' 'zstd' 'libarchive')
depends=('fuse3' 'glibc' 'openssl' 'sqlite' 'zstd' 'libarchive')
provides=('ratarmount')
conflicts=('ratarmount' 'ratarmount-rs-bin')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/ratarmount-rs-${pkgver}"
  cargo build --release --locked -p ratarmount --features nfsv4,sftp-russh
}

package() {
  cd "${srcdir}/ratarmount-rs-${pkgver}"
  install -Dm755 target/release/ratarmount "${pkgdir}/usr/bin/ratarmount"
  install -Dm755 packaging/mount.fuse.ratarmount "${pkgdir}/usr/bin/mount.fuse.ratarmount"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/packaging.md "${pkgdir}/usr/share/doc/${pkgname}/packaging.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
